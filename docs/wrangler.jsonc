{
  "name": "intasend-rs-docs",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist"
  },
  // No custom domain yet. `wrangler deploy` publishes a Worker, so this serves
  // on intasend-rs-docs.<account-subdomain>.workers.dev — not pages.dev, which
  // is Cloudflare Pages and a different product. Add a `routes` block with
  // `custom_domain: true` when a real hostname exists.
  "observability": {
    "enabled": true
  }
}
