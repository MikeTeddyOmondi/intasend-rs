{
  "name": "intasend-rs-docs",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist"
  },
  // Custom domain, following the same shape as tech-docs (docs.mt0.dev).
  //
  // `custom_domain: true` makes Cloudflare create and manage the DNS record
  // for this hostname, so the zone must already be on Cloudflare. Without a
  // route the Worker only answers on
  // intasend-rs-docs.rancko-solutions-llc.workers.dev.
  "routes": [
    {
      "pattern": "intasend-rs.mt0.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
